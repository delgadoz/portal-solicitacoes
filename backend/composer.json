{
    "name": "rodrigo/portal-solicitacoes",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.7"
    },
    "authors": [
        {
            "name": "Rodrigo Delgado",
            "email": "rodrigo21delgado@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "serve": "php -S localhost:8080 -t ../frontend public/index.php"
    },
    "config": {
        "process-timeout": 0
    }
}
